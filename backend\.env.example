# MediMate AI Backend Environment Variables
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Optional: Path to Tesseract OCR binary (e.g., on Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_PATH=

# Optional: Server-side AI model key (Keep server-side only; never expose in frontend)
AI_API_KEY=
